#
# Doxygen config for the libtracer reference implementation. Emits XML only —
# Breathe (docs/conf.py) renders it into the Sphinx site as source references.
# Run from the repo root: `doxygen core/Doxyfile`.
#
# Scope is the *documented* public surface — every header under
# core/include/libtracer/ that carries the @brief discipline of core/STYLE.md.
# WARN_AS_ERROR makes an undocumented public symbol a hard failure — the CI gate
# (docs.yml). Add headers to INPUT as they gain Doxygen coverage.
#
# One header is deliberately absent: byteorder.hpp is entirely `tr::detail`, and
# EXCLUDE_SYMBOLS drops that namespace, so listing it would add an empty file
# entry and nothing else. Its entities still carry @brief comments (core/STYLE.md
# applies to internals too); they are simply not part of the rendered surface.

PROJECT_NAME           = libtracer
PROJECT_BRIEF          = "Decentralized graph-of-endpoints protocol — reference implementation"

OUTPUT_DIRECTORY       = docs/_doxygen
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

INPUT                  = core/include/libtracer/config.hpp \
                         core/include/libtracer/reclaim.hpp \
                         core/include/libtracer/backend.hpp \
                         core/include/libtracer/segment.hpp \
