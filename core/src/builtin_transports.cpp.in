#include "libtracer/builtin_transports.hpp"

namespace tr::net {

void register_builtin_transports(transport_vertex_t& vertex, mem::mem_backend_t* rx_backend,
                                 mem::block_source_t* egress_src) {
    (void)vertex;
    (void)rx_backend;
    (void)egress_src;
    register_udp_transport(vertex, rx_backend, egress_src);  // builtin: udp
    register_tcp_transport(vertex, rx_backend, egress_src);  // builtin: tcp
    register_ws_transport(vertex, rx_backend, egress_src);  // builtin: ws
}

}  // namespace tr::net
