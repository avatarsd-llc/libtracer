#
# Defaults for the libtracer full-node example.
#
# C++ exceptions and RTTI stay at the ESP-IDF default (OFF): the libtracer
# data path is exception-free and RTTI-free (std::expected, never throws), and
# this example avoids <future> for the same reason — the full node links clean
# under -fno-exceptions -fno-rtti.

# Optimize for size (-Os). This is the footprint-reference example (the size
# sentinel measures the libtracer component archive from THIS build), so it must
# compile the way a flash-budget node actually ships — for space, not the IDF
# default -Og (COMPILER_OPTIMIZATION_DEBUG). Measuring -Og would overstate the
# footprint by ~30% and gate against a config no size-constrained deployment
# uses. -Os is what keeps the ADR-0053 two-instantiation terminus (arena +
# lazy-rope resolve walks, both link-retained on the full node) inside the
# component flash ceiling.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# app_main runs the whole self-proof (two graphs + wire builders) — give the
# main task room.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# std::thread on ESP-IDF is pthread on FreeRTOS: every libtracer recv thread
# (one per socket transport) gets THIS stack unless the app sets a pthread cfg.
# The udp recv loop keeps its big scratch off the stack (lazy heap), but the
# tcp serve loop carries ~4 KiB frame chunks + TLV decode frames; 12 KiB is a
# comfortable floor. Tune per-node with real high-water marks.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=12288

# esp_http_server's native WebSocket API — what httpd_ws_link_t rides. Since #947
# the IDF-native links ARE the chip WebSocket plane (core's POSIX transport_ws is
# not compiled on a chip target at all), and this config defaults to `n`, so
# without it the sanctioned WS SERVER is not built and the on-silicon gate has
# nothing to assert. It also gave httpd_ws_link.cpp its first compile coverage:
# before this, no CI job built that TU, because the portable server it replaces
# was quietly standing in for it.
CONFIG_HTTPD_WS_SUPPORT=y
