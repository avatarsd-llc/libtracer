#
# Defaults for the libtracer P0 in-process smoke app.
#
# C++ exceptions and RTTI are intentionally left at the ESP-IDF default (OFF):
# the libtracer reference core is exception-free and RTTI-free in its data path
# (it returns std::expected, never throws; uses no typeid/dynamic_cast), so the
# P0 profile links clean under -fno-exceptions -fno-rtti. Do not enable them on
# the core's account.

# Give app_main a little extra stack — the in-process graph touches std::
# containers (unordered_map / vector) during register/write.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# No WebSocket server here (#1670). httpd_ws_link.cpp is compiled only under
# CONFIG_LIBTRACER_WS_SERVER, which SELECTS the bus tier, so turning it on in this in-process
# smoke app would cost it the lean default for a link it never uses. Its CI compile coverage
# is the full_node job instead: that example serves WebSocket, opts in to
# CONFIG_LIBTRACER_WS_SERVER, builds for all four targets, and tools/check_esp_ws_plane.py
# asserts the httpd_ws_link TU was actually compiled there.

# RFC-0022 §6 measures the SHIPPED profile. The ESP-IDF default is -Og, which inflates the
# absolute store leg by roughly an order of magnitude and — worse for this bench — does not
# price the copy branch's memcpy the way the deployed image does. -Os is what the reference
# node ships (ADR-0039 erratum) and what the rv32 census in this PR compiles with, so the
# runtime numbers and the static numbers describe one binary shape.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
